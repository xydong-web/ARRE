class DataSourceC(DataSource):
    def do_sample_model_RHC(self, model, state: RHCState):
        cfg = state.cfg

        def sample_group(n: int, cond: dict[str, Tensor], p: float, arm: str, forced=None) -> list[dict]:
            sampler = self.algo.graph_sampler
            sampler.forced = forced
            try:
                grp = self.algo.create_training_data_from_own_samples(model, n, cond["encoding"], p)
            finally:
                sampler.forced = None
            self.set_traj_cond_info(grp, cond)
            for g in grp:
                g["arm"] = arm
            return grp

        def iterator():
            n_pol = self.cfg.algo.num_from_policy
            task = self.task
            while self.active:
                t = self.current_iter
                p = self.algo.get_random_action_prob(t)
                t0 = time.time()
                plan = state.plan(t, n_pol)
                specs = state.prefix_specs(plan)
                dt_plan = time.time() - t0
                trajs: list[dict] = []
                # on-policy slots (identical code path to the baseline iterator)
                n_on = n_pol - len(specs)
                if n_on > 0:
                    ci = task.sample_conditional_information(n_on, t)
                    trajs += sample_group(n_on, ci, p, "onpolicy")
                # prefix slots
                if specs:
                    t1 = time.time()
                    cond = state.offspring_cond(specs, task, model, t)
                    dt_plan += time.time() - t1
                    grp = sample_group(len(specs), cond, p, "prefix", forced=[s["forced"] for s in specs])
                    for g, s in zip(grp, specs, strict=True):
                        g["arm"] = s["arm"]
                        g["elite"] = s["elite"]
                        if g.get("is_valid", True):  # sanity: the forced prefix is really in the trajectory
                            acts = [a for (_, a) in g["traj"]]
                            assert len(acts) >= s["k"] and all(acts[j] == s["forced"][j] for j in range(s["k"])), "forced prefix lost"
                    trajs += grp
                # exact-budget dedupe: top-up with on-policy samples until n_pol NOVEL molecules are available
                if cfg.dedupe:
                    cache = task.score_cache
                    novel = state.novel_smiles(trajs, cache)
                    rounds = 0
                    while len(novel) < n_pol and rounds < cfg.topup_rounds:
                        n_more = max(1, int(math.ceil((n_pol - len(novel)) * (1.0 + cfg.topup_margin))))
                        ci = task.sample_conditional_information(n_more, t)
                        trajs += sample_group(n_more, ci, p, "onpolicy")
                        novel = state.novel_smiles(trajs, cache)
                        rounds += 1
                    trajs = state.trim_to_budget(trajs, cache, n_pol)
                    novel_before = set(state.novel_smiles(trajs, cache))
                else:
                    rounds, novel_before = 0, set()
                self.compute_properties(trajs, mark_as_online=True)
                self.compute_log_rewards(trajs)
                batch_info = self.call_sampling_hooks(trajs)
                stats = state.after_oracle(t, trajs, task, novel_before, dt_plan)
                stats["rhc/topup_rounds"] = float(rounds)
                stats["rhc/batch_size"] = float(len(trajs))
                batch_info.update(stats)
                yield (trajs, batch_info)

        self.iterators.append(iterator)
        return self


class VinaMOOTrainer_RHC(VinaMOOTrainer_semla):
    """RHC trainer.  Select with:  run_opt.py --trainer cgflow.lanes.rhc:VinaMOOTrainer_RHC --set rhc.enable=true"""

    def setup_task(self):
        self.task = VinaMOOTask_semlaRHC(cfg=self.cfg, wrap_model=self._wrap_for_mp)

    def setup_algo(self):
        assert self.cfg.algo.method == "TB"
        self.algo = SynthesisTB3D_semlaRHC(self.env, self.ctx, self.cfg)

    def build_training_data_loader(self):
        if not self.cfg.rhc.enable:
            return super().build_training_data_loader()
        assert self.cfg.num_workers == 0, "RHC keeps its state in the main process"
        assert not self.cfg.replay.use and self.cfg.algo.num_from_dataset == 0
        model = self._wrap_for_mp(self.sampling_model)
        state = RHCState(self.cfg, self.cfg.log_dir, self.cfg.seed)
        self.rhc_state = state  # (not `lane_state`: RFG/SPP uses that name and the two lanes are composed in cgflow.lanes.combo)
        pend = getattr(self, "_rs_pending_c", None)
        if pend is not None:  # resume: the checkpoint is applied as soon as the lane state exists (it is created when the loader is built)
            state.load_state_dict(pend)
            self._rs_pending_c = None
        src = DataSourceC(self.cfg, self.ctx, self.algo, self.task, replay_buffer=None)
        src.do_sample_model_RHC(model, state)
        if self.cfg.log_dir:
            src.add_sampling_hook(CustomSQLiteLogHook(str(Path(self.cfg.log_dir) / "train"), self.ctx))
        for hook in self.sampling_hooks:
            src.add_sampling_hook(hook)
        return self._make_data_loader(src)

    # cull-safe resume (run/rs_support.py): checkpoint = lane state + the oracle's score cache
    def rs_extra_state(self):
        st = getattr(self, "rhc_state", None)
        if st is None:
            return {"rhc": None}
        return {"rhc": {"state": st.state_dict(), "score_cache": dict(self.task.score_cache)}}

    def rs_load_extra_state(self, ex):
        d = ex.get("rhc")
        if d is None:
            return
        assert self.cfg.rhc.enable, "checkpoint carries RHC state but rhc.enable is false"
        self.task.score_cache = dict(d["score_cache"])
        self._rs_pending_c = d["state"]
