ARMS = ("onpolicy", "prefix1", "prefix2")
ALPHA0, BETA0 = 0.5, 4.5  # Beta prior of the per-call hit rate (mean 0.1, strength 5)
FAIL_R = 1.5e-4  # r_vina <= FAIL_R  <=>  not a negative Vina score (clamped / failed); same rule as eval/extract_topk.py


# --------------------------------------------------------------------------------------------------------------------
# sampler: forced prefix
# --------------------------------------------------------------------------------------------------------------------
class SyntheticPathSampler3D_semlaRHC(SyntheticPathSampler3D_semla):
    """3D sampler that can replay a given action prefix.  `forced[i]` is the list of RxnActions to force for trajectory i of
    the NEXT `sample_from_model` call (None / shorter list => sampled from the policy as usual)."""

    forced: list | None = None

    def sample_from_model(self, model, n, cond_info, random_action_prob=0.0):
        self._step = -1
        self._active = list(range(n))
        try:
            return super().sample_from_model(model, n, cond_info, random_action_prob)
        finally:
            self._step = -1
            self._active = []

    def _estimate_policy(self, model, torch_graphs, cond_info, not_done_mask):
        # one call per loop iteration of sample_from_model  =>  step index and the (ordered) indices of the active trajectories
        self._step += 1
        self._active = [i for i, nd in enumerate(not_done_mask) if nd]
        assert len(self._active) == len(torch_graphs)
        return super()._estimate_policy(model, torch_graphs, cond_info, not_done_mask)

    def _sample_action(self, torch_graphs, fwd_cat, random_action_prob=0):
        actions = super()._sample_action(torch_graphs, fwd_cat, random_action_prob)
        if self.forced is not None:
            for j, i in enumerate(self._active):
                f = self.forced[i] if i < len(self.forced) else None
                if f is not None and self._step < len(f):
                    actions[j] = self.ctx.GraphAction_to_ActionIndex(torch_graphs[j], f[self._step])
        return actions


class SynthesisTB3D_semlaRHC(SynthesisTB3D_semla):
    def setup_graph_sampler(self):
        self.graph_sampler = SyntheticPathSampler3D_semlaRHC(
            self.ctx,
            self.env,
            self.action_subsampler,
            max_len=self.max_len,
            importance_temp=self.importance_temp,
