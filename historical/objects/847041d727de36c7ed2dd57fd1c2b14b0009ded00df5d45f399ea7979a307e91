# --------------------------------------------------------------------------------------------------------------------
# task: exact-budget dedupe
# --------------------------------------------------------------------------------------------------------------------
class VinaMOOTask_semlaRHC(VinaMOOTask_semla):
    """Oracle wrapper that never docks the same canonical SMILES twice (baseline: only the best 2000 QED>0.5 molecules are cached)."""

    def __init__(self, cfg, wrap_model):
        super().__init__(cfg, wrap_model)
        self.rhc_cfg = cfg.rhc
        self.score_cache: dict[str, float] = {}
        self.dock_calls_last = 0
        self.cache_hits_last = 0

    def _calc_vina_score_batch(self, objs):
        if not (self.rhc_cfg.enable and self.rhc_cfg.dedupe):
            return super()._calc_vina_score_batch(objs)
        smiles = [Chem.MolToSmiles(o) for o in objs]
        first: dict[str, int] = {}
        hits = 0
        for i, s in enumerate(smiles):
            if s in self.score_cache:
                hits += 1
            elif s not in first:
                first[s] = i
            else:
                hits += 1  # duplicate inside the batch
        if first:
            idx = list(first.values())
            new_scores = super()._calc_vina_score_batch([objs[i] for i in idx])
            for s, sc in zip(first.keys(), new_scores, strict=True):
                self.score_cache[s] = float(sc)
        self.dock_calls_last = len(first)
        self.cache_hits_last = hits
        return [self.score_cache[s] for s in smiles]


# --------------------------------------------------------------------------------------------------------------------
# bookkeeping: evaluation-protocol modes / elite archive
# --------------------------------------------------------------------------------------------------------------------
class ModeTracker:
    """All docked molecules with negative Vina and QED > qed_min, plus the greedy diverse top set of the evaluation protocol."""

    def __init__(self, k_modes: int, k_elite: int, thresh: float, qed_min: float):
        self.k_modes, self.k_elite, self.thresh, self.qed_min = k_modes, k_elite, thresh, qed_min
        self.history: dict[str, dict] = {}
        self.fps: dict[str, object] = {}
        self._sorted: list[tuple[float, str]] = []
        self.modes: list[str] = []  # greedy diverse list, best first (length <= k_elite)

    def eligible(self, vina: float, qed: float) -> bool:
        return vina < 0.0 and qed > self.qed_min

    def add(self, smi: str, vina: float, qed: float, actions: list, arm: str, it: int, obj_props: tuple, cond: dict) -> bool:
        if smi in self.history or not self.eligible(vina, qed):
            return False
        mol = Chem.MolFromSmiles(smi)
        if mol is None:
            return False
        self.fps[smi] = Chem.RDKFingerprint(mol)
        self.history[smi] = dict(vina=vina, qed=qed, actions=actions, arm=arm, it=it, obj_props=obj_props, cond=cond)
        bisect.insort(self._sorted, (vina, smi))
        return True

    def refresh(self) -> set[str]:
        """Recompute the greedy diverse list; return the molecules that newly entered the evaluated top-k_modes set."""
        before = set(self.modes[: self.k_modes])
        acc: list[str] = []
        acc_fps = []
        for _, smi in self._sorted:
            fp = self.fps[smi]
            if acc_fps and max(DataStructs.BulkTanimotoSimilarity(fp, acc_fps)) >= self.thresh:
                continue
            acc.append(smi)
            acc_fps.append(fp)
            if len(acc) >= self.k_elite:
                break
        self.modes = acc
        return set(acc[: self.k_modes]) - before

    def elites(self, min_len: int) -> list[str]:
        return [s for s in self.modes if len(self.history[s]["actions"]) >= min_len]

    def top_stats(self) -> tuple[float, int, int]:
        top = self.modes[: self.k_modes]
        if not top:
            return 0.0, 0, 0
        v = [self.history[s]["vina"] for s in top]
        return float(np.mean(v)), int(sum(x < -10.0 for x in v)), len(top)

    # ---- cull-safe resume: history is the only primary state; fingerprints / sorted list / greedy modes are re-derived ----------
    def state_dict(self) -> dict:
        return {"history": self.history}

    def load_state_dict(self, d: dict) -> None:
        self.history = d["history"]
        self.fps = {s: Chem.RDKFingerprint(Chem.MolFromSmiles(s)) for s in self.history}
        self._sorted = sorted((h["vina"], s) for s, h in self.history.items())  # same order as the incremental bisect.insort
        self.modes = []
        self.refresh()


# --------------------------------------------------------------------------------------------------------------------
# behaviour portfolio: discounted Thompson sampling
# --------------------------------------------------------------------------------------------------------------------
class ZEstimator:
    """Kernel-regressed TB-implied log-partition.

    At the TB optimum the conditional-flow head satisfies  log Z(c) = E_{tau ~ P_F(.|c)} [ log R_c(x_tau) - sum_t log P_F(a_t | s_t) ] + KL(P_F || P*),
    i.e. the conditional mean  v(c) = E[log R_c - log P_F(tau)]  is the SQUARED-ERROR-OPTIMAL value of the head (it is what the TB loss regresses the head to) and a
    Jensen lower bound of log Z that becomes tight as the policy calibrates.  The head itself needs thousands of steps to reach it; a local average over recent
    on-policy samples reaches it immediately.  Only valid trajectories are used (invalid ones carry the -75 clamp and would dominate a mean in log space).
    """

    def __init__(self, capacity: int, min_n: int, bw_beta: float, bw_w: float):
        self.cap, self.min_n = capacity, min_n
        self.bw = np.array([bw_beta, bw_w], dtype=np.float64)
        self.c = np.zeros((0, 2))
        self.v = np.zeros(0)

    def __len__(self):
        return len(self.v)

    def add(self, beta, w, v) -> None:
        c = np.stack([np.asarray(beta, np.float64) / 64.0, np.asarray(w, np.float64)], 1)
        self.c = np.concatenate([self.c, c])[-self.cap :]
        self.v = np.concatenate([self.v, np.asarray(v, np.float64)])[-self.cap :]

    def predict(self, beta, w):
        """-> (log Z estimate [n], usable mask [n]); unusable entries (too few neighbours) must fall back to the head."""
        n = len(beta)
        if len(self.v) < self.min_n:
            return np.full(n, np.nan), np.zeros(n, bool)
        q = np.stack([np.asarray(beta, np.float64) / 64.0, np.asarray(w, np.float64)], 1)
        d = (q[:, None, :] - self.c[None, :, :]) / self.bw
        k = np.exp(-0.5 * (d * d).sum(-1))  # [n, m]
        den = k.sum(1)
        ok = den > 1.0  # at least about one effective neighbour
        est = np.where(ok, (k @ self.v) / np.maximum(den, 1e-12), np.nan)
        return est, ok

    def state_dict(self) -> dict:
        return {"c": self.c.copy(), "v": self.v.copy()}

    def load_state_dict(self, d: dict) -> None:
        self.c, self.v = np.array(d["c"], dtype=np.float64), np.array(d["v"], dtype=np.float64)


class Portfolio:
    def __init__(self, cfg, seed: int):
        self.cfg = cfg
        self.rng = np.random.RandomState(seed + 7919)
        self.alpha = np.full(len(ARMS), ALPHA0)
        self.beta = np.full(len(ARMS), BETA0)
        self.last_theta = np.zeros(len(ARMS))

    def allocate(self, n_total: int, avail: dict[str, bool]) -> dict[str, int]:
        cfg = self.cfg
        pref_arms = [a for a in ARMS[1:] if avail.get(a, False)]
        if not pref_arms:
            return {"onpolicy": n_total, "prefix1": 0, "prefix2": 0}
        theta = self.rng.beta(self.alpha, self.beta)
        self.last_theta = theta
        if cfg.bandit:
            tot = theta[0] + sum(theta[ARMS.index(a)] for a in pref_arms)
            frac = {a: min(cfg.prefix_cap, theta[ARMS.index(a)] / tot) for a in pref_arms}
        else:
            frac = {a: min(cfg.prefix_cap, cfg.fixed_prefix_frac / len(pref_arms)) for a in pref_arms}
        tot_p = sum(frac.values())
        room = 1.0 - cfg.onpolicy_floor
        if tot_p > room:
            frac = {a: f * room / tot_p for a, f in frac.items()}
            tot_p = room
        fr = np.array([1.0 - tot_p] + [frac.get(a, 0.0) for a in ARMS[1:]])
        raw = fr * n_total
        cnt = np.floor(raw).astype(int)
        for j in np.argsort(-(raw - cnt))[: n_total - cnt.sum()]:
            cnt[j] += 1
        return dict(zip(ARMS, (int(c) for c in cnt), strict=True))

    def update(self, calls: dict[str, int], hits: dict[str, int]) -> None:
        g = self.cfg.bandit_discount
        for j, a in enumerate(ARMS):
            c, h = calls.get(a, 0), min(hits.get(a, 0), calls.get(a, 0))
            self.alpha[j] = ALPHA0 + g * (self.alpha[j] - ALPHA0) + h
            self.beta[j] = BETA0 + g * (self.beta[j] - BETA0) + (c - h)

    def state_dict(self) -> dict:
        return {"alpha": self.alpha.copy(), "beta": self.beta.copy(), "last_theta": self.last_theta.copy(), "rng": self.rng.get_state()}

    def load_state_dict(self, d: dict) -> None:
        self.alpha, self.beta, self.last_theta = (np.array(d[k], dtype=np.float64) for k in ("alpha", "beta", "last_theta"))
        self.rng.set_state(d["rng"])


# --------------------------------------------------------------------------------------------------------------------
# lane state: planning, offspring conditions, post-oracle updates
# --------------------------------------------------------------------------------------------------------------------
class RHCState:
    def __init__(self, cfg, log_dir: str | Path, seed: int):
        self.cfg = cfg.rhc
        self.tracker = ModeTracker(self.cfg.k_modes, self.cfg.elite_size, self.cfg.elite_sim, self.cfg.qed_min)
        self.portfolio = Portfolio(self.cfg, seed)
        self.rng = np.random.RandomState(seed + 4242)
        self.zest = ZEstimator(self.cfg.z_capacity, self.cfg.z_min_n, self.cfg.z_bw_beta, self.cfg.z_bw_w)
        self.cond_stats: dict[str, float] = {}
        self.gen = torch.Generator().manual_seed(seed + 99)
        self.seen: set[str] = set()  # every molecule that has been docked
        self.n_docked_total = 0
        self.arm_file = None
        if self.cfg.log_arms:
            d = Path(log_dir) / "rhc"
            d.mkdir(parents=True, exist_ok=True)
            self.arm_file = open(d / "arms.tsv", "a", buffering=1)
            self.arm_file.write("it\tarm\tsmiles\tvina\tqed\thit\telite\n")

    # ---- cull-safe resume ---------------------------------------------------------------------------------------------
    def state_dict(self) -> dict:
        return {"tracker": self.tracker.state_dict(), "portfolio": self.portfolio.state_dict(), "rng": self.rng.get_state(), "zest": self.zest.state_dict(),
                "cond_stats": dict(self.cond_stats), "gen": self.gen.get_state(), "seen": set(self.seen), "n_docked_total": int(self.n_docked_total)}

    def load_state_dict(self, d: dict) -> None:
        self.tracker.load_state_dict(d["tracker"])
        self.portfolio.load_state_dict(d["portfolio"])
        self.rng.set_state(d["rng"])
        self.zest.load_state_dict(d["zest"])
        self.cond_stats = dict(d["cond_stats"])
        self.gen.set_state(d["gen"])
        self.seen = set(d["seen"])
        self.n_docked_total = int(d["n_docked_total"])

    # ---- planning -------------------------------------------------------------------------------------------------
    def plan(self, it: int, n: int) -> dict[str, int]:
        avail = {a: False for a in ARMS[1:]}
        if it >= self.cfg.warmup_iters:
            avail["prefix1"] = len(self.tracker.elites(2)) >= self.cfg.min_elites
            avail["prefix2"] = len(self.tracker.elites(3)) >= self.cfg.min_elites
        return self.portfolio.allocate(n, avail)

    def prefix_specs(self, plan: dict[str, int]) -> list[dict]:
        specs = []
        for arm in ARMS[1:]:
            n = plan.get(arm, 0)
            if n <= 0:
                continue
            k = int(arm[-1])
            elites = self.tracker.elites(k + 1)
            ranks = np.arange(len(elites))
            w = 1.0 / (self.cfg.rank_kappa * max(len(elites), 1) + ranks + 1.0)
            w = w / w.sum()
            picks = self.rng.choice(len(elites), n, replace=n > len(elites), p=w)
            for pi in picks:
                e = self.tracker.history[elites[pi]]
                specs.append(dict(arm=arm, k=k, forced=list(e["actions"][:k]), elite=elites[pi], obj_props=e["obj_props"], cond=e["cond"]))
        return specs

    def offspring_cond(self, specs: list[dict], task, model, it: int) -> dict[str, Tensor]:
        n, mode = len(specs), self.cfg.cond_mode
        if mode == "prior":
            return task.sample_conditional_information(n, it)
        if mode == "inherit":
            return {k: torch.stack([s["cond"][k] for s in specs]) for k in specs[0]["cond"]}
        assert mode == "posterior", mode
        M = self.cfg.hindsight_candidates
        ci = task.sample_conditional_information(n * M, it)  # prior draws p(c)
        op = torch.tensor([s["obj_props"] for s in specs], dtype=torch.float32).repeat_interleave(M, dim=0)
        log_r = task.cond_info_to_logreward(ci, op).float().view(n, M)
        dev = next(model.parameters()).device
        with torch.no_grad():
            log_z = model.logZ(ci["encoding"].to(dev))[:, 0].float().cpu()  # [n*M] trained head
        used_kernel = 0.0
        if self.cfg.z_estimator == "kernel":
            est, ok = self.zest.predict(ci["beta"].numpy(), ci["preferences"][:, 0].numpy())
            est_t, ok_t = torch.from_numpy(est).float(), torch.from_numpy(ok)
            used_kernel = float(ok_t.float().mean()) if len(est) else 0.0
            log_z = torch.where(ok_t, est_t, log_z)
        log_z = log_z.view(n, M)
        w = torch.softmax(log_r - log_z, dim=1)
        ess = 1.0 / (w * w).sum(1)  # effective sample size of the self-normalised importance resampler
        idx = torch.multinomial(w, 1, generator=self.gen)[:, 0]
        sel = torch.arange(n) * M + idx
        out = {k: v[sel].clone() for k, v in ci.items()}
        skip = ess < self.cfg.ess_min * M
        if skip.any():  # degenerate resampler => keep the elite's own condition
            for k in out:
                inh = torch.stack([s["cond"][k] for s in specs]).to(out[k].dtype)
                out[k][skip] = inh[skip]
        self.cond_stats = {
            "rhc/cond_ess": float(ess.mean()),
            "rhc/cond_skipped": float(skip.float().mean()),
            "rhc/cond_beta_mean": float(out["beta"].mean()),
            "rhc/cond_kernel_frac": used_kernel,
        }
        return out

    # ---- dedupe helpers -------------------------------------------------------------------------------------------
    @staticmethod
    def novel_smiles(trajs: list[dict], cache) -> list[str]:
        out, seen = [], set()
        for t in trajs:
            if not t.get("is_valid", True):
                continue
            s = t["result"].smi
            if s not in cache and s not in seen:
                seen.add(s)
                out.append(s)
        return out

    @staticmethod
    def trim_to_budget(trajs: list[dict], cache, budget: int) -> list[dict]:
        """Keep trajectories whose molecule is cached/valid-duplicate or among the first `budget` distinct novel ones."""
        kept, novel = [], set()
        for t in trajs:
            if t.get("is_valid", True):
                s = t["result"].smi
                if s not in cache:
                    if s not in novel:
                        if len(novel) >= budget:
                            continue
                        novel.add(s)
            kept.append(t)
        return kept

    # ---- after the oracle -------------------------------------------------------------------------------------------
    def after_oracle(self, it: int, trajs: list[dict], task, novel_before: set[str], dt_plan: float) -> dict[str, float]:
        calls = {a: 0 for a in ARMS}
        cand = []  # (smi, arm) first occurrences docked this iteration
        this_iter: dict[str, str] = {}
        n_added = 0
        for t in trajs:
            if not t.get("is_valid", True):
                continue
            smi = t["result"].smi
            if smi in this_iter or smi in self.seen:
                continue
            arm = t.get("arm", "onpolicy")
            this_iter[smi] = arm
            calls[arm] += 1
            op = t["obj_props"]
            r_vina, qed = float(op[0]), float(op[1])
            vina = -10.0 * r_vina if r_vina > FAIL_R else 0.0
            actions = [a for (_, a) in t["traj"]]
            ci = {k: (v.detach().cpu().clone() if torch.is_tensor(v) else v) for k, v in t["cond_info"].items()}
            if self.tracker.add(smi, vina, qed, actions, arm, it, (r_vina, qed), ci):
                n_added += 1
            cand.append((smi, arm, vina, qed, t.get("elite", "-")))
        self.seen.update(this_iter.keys())
        self.n_docked_total += len(this_iter)
        entrants = self.tracker.refresh()
        hits = {a: 0 for a in ARMS}
        hit_set = set()
        for smi in entrants:
            if smi in this_iter:
                hits[this_iter[smi]] += 1
                hit_set.add(smi)
        self.portfolio.update(calls, hits)
        # TB-implied value of the ON-POLICY samples = training data of the kernel log Z estimator
        zb, zw, zv = [], [], []
        for t in trajs:
            if t.get("arm", "onpolicy") != "onpolicy" or not t.get("is_valid", True):
                continue
            zb.append(float(t["cond_info"]["beta"]))
            zw.append(float(t["cond_info"]["preferences"][0]))
            zv.append(float(t["log_reward"]) - float(t["fwd_logprob"]))
        if zv:
            self.zest.add(np.array(zb), np.array(zw), np.array(zv))
        if self.arm_file is not None:
            for smi, arm, vina, qed, elite in cand:
                self.arm_file.write(f"{it}\t{arm}\t{smi}\t{vina:.3f}\t{qed:.3f}\t{int(smi in hit_set)}\t{elite}\n")
        top_mean, n_lt10, n_top = self.tracker.top_stats()
        elite_v = [self.tracker.history[s]["vina"] for s in self.tracker.modes]
        st = {
            "rhc/top_mean_vina": top_mean,
            "rhc/top_n": float(n_top),
            "rhc/top_n_lt10": float(n_lt10),
            "rhc/elite_n": float(len(self.tracker.modes)),
            "rhc/elite_mean_vina": float(np.mean(elite_v)) if elite_v else 0.0,
            "rhc/dock_calls": float(getattr(task, "dock_calls_last", len(this_iter))),
            "rhc/cache_hits": float(getattr(task, "cache_hits_last", 0)),
            "rhc/docked_total": float(self.n_docked_total),
            "rhc/plan_s": dt_plan,
        }
        st["rhc/zest_n"] = float(len(self.zest))
        st.update(self.cond_stats)
        for j, a in enumerate(ARMS):
            st[f"rhc/calls_{a}"] = float(calls[a])
            st[f"rhc/hits_{a}"] = float(hits[a])
            st[f"rhc/theta_{a}"] = float(self.portfolio.alpha[j] / (self.portfolio.alpha[j] + self.portfolio.beta[j]))
        return st


